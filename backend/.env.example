# Server config only. Never commit real secrets. Copy to .env for local dev.
DATABASE_URL=sqlite:///./dev.db
# Production/staging example (PostgreSQL required outside local dev):
# DATABASE_URL=postgresql+psycopg://tryon:tryon@localhost:5432/tryon
ALLOWED_WEB_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=1209600
COOKIE_SECURE=false
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./media
MEDIA_BASE_URL=http://localhost:8000
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# EMAIL_PROVIDER=none
DEMO_MODE=true
# Dev admin bootstrap (explicit setup command reads these from the environment):
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_PASSWORD=
